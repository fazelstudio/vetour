{
  "name": "vetour",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p packages/vetour-sdk",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "postinstall": "bun run scripts/download-sidecar.ts",
    "sidecar:download": "bun run scripts/download-sidecar.ts",
    "sdk:publish": "bun run scripts/publish-sdk.ts",
    "sdk:test": "bun run scripts/test-sdk.ts"
  },
  "dependencies": {
    "@photo-sphere-viewer/core": "^5.14.3",
    "@photo-sphere-viewer/markers-plugin": "^5.14.3",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.14.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "pako": "^3.0.0",
    "papaparse": "^5.5.4",
    "radix-ui": "^1.6.1",
    "react": "^19.1.0",
    "react-best-gradient-color-picker": "^3.0.14",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tauri-plugin-snap-layout": "^1.0.9",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "vetour-sdk": "workspace:*",
    "@types/node": "^26.1.0",
    "@types/pako": "^2.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.0.4"
  }
}
